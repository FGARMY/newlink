# ==============================================================================
# Newlink Web Frontend (Next.js) — Production Configuration
# ==============================================================================

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# NestJS API endpoint for Server Components (Internal Docker networking or VPC)
API_BASE_URL=http://api:4000/api/v1

# Public URL used in browser requests & SEO canonicals
NEXT_PUBLIC_SITE_URL=https://newlink.co.in
NEXT_PUBLIC_API_URL=https://api.newlink.co.in/api/v1

# Production Razorpay Key (Public)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_replace
