# ==============================================================================
# Newlink Backend API (NestJS) — Production Configuration
# ==============================================================================

NODE_ENV=production
API_PORT=4000

# Data Driver: 'memory' | 'postgres'
DATA_DRIVER=memory
DATABASE_URL=postgres://newlink_prod:replace_with_strong_password@postgres:5432/newlink_prod

# Cache and Rate Limiting
REDIS_URL=redis://redis:6379

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=https://newlink.co.in,https://admin.newlink.co.in

# S3 Compatible Object Storage
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_ACCESS_KEY=replace_with_s3_key
S3_SECRET_KEY=replace_with_s3_secret
S3_PUBLIC_BUCKET=newlink-media-prod
S3_PRIVATE_BUCKET=newlink-kyc-prod

# Razorpay Production Keys
RAZORPAY_KEY_ID=rzp_live_replace
RAZORPAY_KEY_SECRET=replace_secret
RAZORPAY_WEBHOOK_SECRET=replace_webhook_secret
