# Local development defaults. Copy to `.env` and adjust. NEVER commit real secrets.

# ---- API ----
API_PORT=4000
# memory | postgres — the data driver is configurable on purpose (PRD §7)
DATA_DRIVER=memory
DATABASE_URL=postgres://newlink:newlink@localhost:5432/newlink
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
REDIS_URL=redis://localhost:6379

# ---- Tests ----
# When set, the Postgres reservation contract tests run against this database.
TEST_DATABASE_URL=postgres://newlink:newlink@localhost:5432/newlink_test

# ---- Web ----
API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Object storage (MinIO locally, S3/R2 in prod) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=newlink
S3_SECRET_KEY=newlink-dev-secret
S3_PUBLIC_BUCKET=newlink-media
S3_PRIVATE_BUCKET=newlink-kyc
