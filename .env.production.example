# ==============================================================================
# Newlink Self-Drive Car Rental Platform — Production Environment Configuration
# NEVER COMMIT REAL PRODUCTION SECRETS TO SOURCE CONTROL
# ==============================================================================

# ---- Node Environment ----
NODE_ENV=production

# ---- Database (PostgreSQL 17) ----
POSTGRES_USER=newlink_prod
POSTGRES_PASSWORD=replace_with_strong_random_password_min_32_chars
POSTGRES_DB=newlink_prod
# Connection string used by API services
DATABASE_URL=postgres://newlink_prod:replace_with_strong_random_password_min_32_chars@postgres:5432/newlink_prod

# ---- Cache & Queue (Redis 7) ----
REDIS_URL=redis://redis:6379

# ---- API Service ----
API_PORT=4000
DATA_DRIVER=memory
CORS_ORIGINS=https://newlink.co.in,https://admin.newlink.co.in,https://api.newlink.co.in

# ---- Web / Frontend Service ----
PORT=3000
# Internal URL used by Next.js Server Components to reach NestJS API within Docker network
INTERNAL_API_URL=http://api:4000/api/v1
# Public URL used by client-side browser requests
API_BASE_URL=https://api.newlink.co.in/api/v1
NEXT_PUBLIC_SITE_URL=https://newlink.co.in

# ---- Object Storage (AWS S3 / Cloudflare R2 / MinIO) ----
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_ACCESS_KEY=replace_with_iam_access_key
S3_SECRET_KEY=replace_with_iam_secret_key
S3_PUBLIC_BUCKET=newlink-media-prod
S3_PRIVATE_BUCKET=newlink-kyc-prod

# ---- Payment Gateway (Razorpay) ----
RAZORPAY_KEY_ID=rzp_live_replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# ---- SMS / OTP Provider (DLT Compliant) ----
SMS_PROVIDER=msg91
SMS_AUTH_KEY=replace_with_msg91_auth_key
SMS_SENDER_ID=NWLINK
SMS_DLT_TE_ID_OTP=replace_with_dlt_template_id
