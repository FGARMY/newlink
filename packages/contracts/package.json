{
  "name": "@newlink/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas and API contracts for web, admin and backend.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
